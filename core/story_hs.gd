## 高校生モードの章。仕組みは中学生モードのものを借り、文だけ差し替える
static func chapters() -> Array:
	var out: Array = []
	for cid in ["ch17", "ch18", "ch27", "ch28", "ch8", "ch9", "ch29", "ch30", "ch10"]:
		var src: Dictionary = StoryDefs.chapter_by_id(cid)
		if src.is_empty() or not TEXT.has(cid):
			continue
		out.append(_retell(src, TEXT[cid]))
	return out


## 1 章ぶん。図・測る中身・答えはそのままで、題名と会話だけ入れかえる
static func _retell(src: Dictionary, t: Dictionary) -> Dictionary:
	var ch := src.duplicate(true)
	ch["title"] = String(t["title"])
	ch["place"] = String(t["place"])
	ch["level"] = "高校の内容"
	var titles: Array = t["titles"]
	var scenes: Array = ch["scenes"]
	for i in scenes.size():
		var sc: Dictionary = scenes[i]
		if i < titles.size():
			sc["title"] = String(titles[i])
		# 挿絵は星空にそろえる(舞台が惑星の基地なので、噴水や劇場の絵は合わない)
		if sc.has("art"):
			sc["art"] = "night"
		match i:
			0:
				sc["lines"] = (t["talk0"] as Array).duplicate()
			1:
				sc["lead"] = String(t["lead1"])
				sc["after"] = String(t["after1"])
			2:
				sc["lines"] = (t["talk2"] as Array).duplicate()
			3:
				sc["lead"] = String(t["lead3"])
				sc["after"] = String(t["after3"])
			4:
				sc["lines"] = (t["talk4"] as Array).duplicate()
	return ch
