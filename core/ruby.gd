## 文に よみ を付ける。小学 1 年で習わない漢字には かならず付ける(出るたびに毎回)。
## 頭から 1 文字ずつ見て、その場所で いちばん長い言葉に当てる。
## (「円周率」を「円周(えんしゅう)率(えんしゅうりつ)」にしないため、
##  当てた言葉のうしろへは飛ばして、二重に当てない)
static func apply(text: String) -> String:
	if text == "":
		return text
	var sorted: Array = WORDS.duplicate()
	sorted.sort_custom(func(a, b): return String(a[0]).length() > String(b[0]).length())
	var out := ""
	var i := 0
	while i < text.length():
		var hit := ""
		var yomi := ""
		for w in sorted:
			var word := String(w[0])
			if text.substr(i, word.length()) == word:
				hit = word
				yomi = String(w[1])
				break
		if hit == "":
			out += text.substr(i, 1)
			i += 1
			continue
		if _all_plain(hit):
			# 小 1 の漢字だけの語(石・空・山 など)は そのままでよい
			out += hit
			i += hit.length()
			continue
		out += hit + "(" + yomi + ")"
		i += hit.length()
	return out


## 文を「そのまま出す部分」と「よみ を付ける部分」に分ける。
## ui/ruby_label.gd が、漢字の上に よみ を乗せて描くのに使う。
## 戻り値: [{"s": 文字, "r": よみ(無ければ "")}, ...]
static func parts(text: String) -> Array:
	var out: Array = []
	if text == "":
		return out
	var sorted: Array = WORDS.duplicate()
	sorted.sort_custom(func(a, b): return String(a[0]).length() > String(b[0]).length())
	var plain := ""
	var i := 0
	while i < text.length():
		var hit := ""
		var yomi := ""
		for w in sorted:
			var word := String(w[0])
			if text.substr(i, word.length()) == word:
				hit = word
				yomi = String(w[1])
				break
		if hit == "" or _all_plain(hit):
			plain += text.substr(i, maxi(hit.length(), 1))
			i += maxi(hit.length(), 1)
			continue
		if plain != "":
			out.append({"s": plain, "r": ""})
			plain = ""
		out.append({"s": hit, "r": yomi})
		i += hit.length()
	if plain != "":
		out.append({"s": plain, "r": ""})
	return out


## その語が 小 1 の漢字だけでできているか
static func _all_plain(word: String) -> bool:
	for i in word.length():
		var ch := word.substr(i, 1)
		var code := word.unicode_at(i)
		var is_kanji := code >= 0x4E00 and code <= 0x9FFF
		if is_kanji and not plain_ok(ch):
			return false
	return true


## そのステージが小学生むけ(中学受験レベル)か
static func needed(stage_id: String) -> bool:
	return stage_id.begins_with("e")
