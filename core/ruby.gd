class_name Ruby
## 小学生が読む文に、漢字のよみ(フリガナ)を付ける。
##
## Godot の Label にはルビの機能が無いので、「三角形(さんかくけい)」のように
## かっこ書きで添える。子どもの本でもよく使われる形。
## 同じ文の中で何度も出るとうるさいので、**最初の 1 回だけ**付ける。
##
## 使うのは中学受験(小学生)レベルの文だけ。中学・高校の文には付けない。

## よみを付ける言葉。長いものから先に見るので、並び順そのままで使う
const WORDS := [
	["二等辺三角形", "にとうへんさんかくけい"], ["直角三角形", "ちょっかくさんかくけい"],
	["平行四辺形", "へいこうしへんけい"], ["正三角形", "せいさんかくけい"],
	["正多角形", "せいたかくけい"], ["正六角形", "せいろっかくけい"],
	["三角形", "さんかくけい"], ["四角形", "しかくけい"], ["多角形", "たかくけい"],
	["長方形", "ちょうほうけい"], ["正方形", "せいほうけい"], ["台形", "だいけい"],
	["円周率", "えんしゅうりつ"], ["円周", "えんしゅう"],
	["中心角", "ちゅうしんかく"], ["直径", "ちょっけい"], ["半径", "はんけい"],
	["扇形", "おうぎがた"], ["弧", "こ"],
	["内角", "ないかく"], ["外角", "がいかく"], ["対角線", "たいかくせん"],
	["頂点", "ちょうてん"], ["底辺", "ていへん"], ["面積", "めんせき"],
	["表面積", "ひょうめんせき"], ["体積", "たいせき"],
	["直方体", "ちょくほうたい"], ["立方体", "りっぽうたい"],
	["円柱", "えんちゅう"], ["円錐", "えんすい"], ["角柱", "かくちゅう"], ["角錐", "かくすい"],
	["展開図", "てんかいず"], ["水そう", "すいそう"],
	["平行", "へいこう"], ["垂直", "すいちょく"], ["対称", "たいしょう"],
	["相似", "そうじ"], ["合同", "ごうどう"], ["中点", "ちゅうてん"],
	["線分", "せんぶん"], ["交点", "こうてん"], ["折り返", "おりかえ"],
]


## 文に よみ を付ける。同じ言葉は最初の 1 回だけ。
## 頭から 1 文字ずつ見て、その場所で いちばん長い言葉に当てる。
## (「円周率」を「円周(えんしゅう)率(えんしゅうりつ)」にしないため、
##  当てた言葉のうしろへは飛ばして、二重に当てない)
static func apply(text: String) -> String:
	if text == "":
		return text
	var sorted: Array = WORDS.duplicate()
	sorted.sort_custom(func(a, b): return String(a[0]).length() > String(b[0]).length())
	var used := {}
	var out := ""
	var i := 0
	while i < text.length():
		var hit := ""
		var yomi := ""
		for w in sorted:
			var word := String(w[0])
			if text.substr(i, word.length()) == word:
				hit = word
				yomi = String(w[1])
				break
		if hit == "":
			out += text.substr(i, 1)
			i += 1
			continue
		out += hit
		if not used.has(hit):
			used[hit] = true
			out += "(" + yomi + ")"
		i += hit.length()
	return out


## そのステージが小学生むけ(中学受験レベル)か
static func needed(stage_id: String) -> bool:
	return stage_id.begins_with("e")
