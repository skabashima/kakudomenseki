static func by_id(id: String) -> Dictionary:
	for u in UNITS:
		if String(u["id"]) == id:
			return u
	return {}


static func index_of(id: String) -> int:
	for i in UNITS.size():
		if String(UNITS[i]["id"]) == id:
			return i
	return 0


## その単元を開いてよいか(前の単元をクリアしていれば開く)
static func is_unlocked(id: String, cleared: Dictionary) -> bool:
	var i := index_of(id)
	if i <= 0 or cleared.has(id):
		return true
	return cleared.has(String(UNITS[i - 1]["id"]))
